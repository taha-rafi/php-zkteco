{
  "name": "taha-rafi/php-zkteco",
  "description": "Modern, pure native PHP 8.x dual-protocol (TCP + UDP) communication, Direct Hardware ATT_LOG Attendance Writer, Cloud POST Sync, ADMS Push Server, and Real-Time Webhook library for ZKTeco Biometric Time & Attendance devices with native Comm Key authentication.",
  "type": "library",
  "keywords": [
    "zkteco",
    "laravel",
    "biometrics",
    "attendance",
    "fingerprint",
    "zklibrary",
    "socket",
    "tcp",
    "udp",
    "webhooks",
    "adms",
    "iclock",
    "php8",
    "commkey",
    "tx628",
    "zksoftware"
  ],
  "homepage": "https://github.com/taha-rafi/php-zkteco",
  "license": "MIT",
  "authors": [
    {
      "name": "Taha Rafi",
      "email": "connect@taharafi.com",
      "role": "Software Engineer & Lead Developer"
    }
  ],
  "require": {
    "php": ">=8.0.0",
    "ext-sockets": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "TahaRafi\\ZKTeco\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "TahaRafi\\ZKTeco\\Laravel\\ZKTecoServiceProvider"
      ],
      "aliases": {
        "ZKTeco": "TahaRafi\\ZKTeco\\Laravel\\Facades\\ZKTeco"
      }
    }
  },
  "minimum-stability": "stable"
}

